# Storefront API settings. Copy to .env.local and adjust. These are read in the browser (NEXT_PUBLIC_*),
# so never put secrets here.

# Where the browser sends API calls.
#   Empty (default): this app's own /api routes, served by the mock backend in src/server/backend.ts.
#   Set to the client's API origin to use it directly, e.g. https://api.socimco.example
#   That API must allow this site's origin in CORS (and credentials in cookie mode).
NEXT_PUBLIC_API_BASE_URL=

# Which adapter translates between the backend and the storefront.
#   contract (default): the backend speaks our contract exactly (the mock does).
#   custom: use src/core/api/client/adapters/custom-adapter.ts (see src/core/api/README.md).
NEXT_PUBLIC_API_ADAPTER=contract

# How the browser authenticates with the API.
#   cookie (default, preferred): the API sets an HttpOnly session cookie; requests are sent with credentials.
#   bearer: the API returns a token at login; it is kept per tab and sent as "Authorization: Bearer …".
NEXT_PUBLIC_API_AUTH=cookie

# Currency the storefront shows prices in (ISO code). The app is French, so 40000.00 USD shows as "40 000,00 $US".
#   USD (default, the demo data) · EUR → "40 000,00 €" · MAD → "40 000,00 MAD"
NEXT_PUBLIC_CURRENCY=USD

# Sign-in with a phone (QR code on the computer's login page, scanner on the phone). On by default.
#   off: hide it, for a backend without the QR routes. Password sign-in is unaffected.
NEXT_PUBLIC_QR_LOGIN=on

# Abort a request after this many milliseconds (default 15000).
NEXT_PUBLIC_API_TIMEOUT_MS=15000
